          "stringUnit": {
            "state": "translated",
            "value": "Phonon 40m de Gradium: el motor más rápido (muchos capítulos a la vez en la CPU), voces naturales y claras. Un modelo pequeño por idioma (~78 MB). Solo uso no comercial."
          }
        },
        "fr": {
          "stringUnit": {
