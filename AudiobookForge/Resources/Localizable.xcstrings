    "Immer aktiv: Silbentrennung wird zusammengeführt, Ligaturen aufgelöst, Kolumnentitel und Seitenzahlen entfernt, Verzeichnisse übersprungen, Tabellen (EPUB) zeilenweise gelesen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on: hyphenation is joined, ligatures resolved, running heads and page numbers removed, indexes skipped, tables (EPUB) read row by row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre activo: se unen las palabras divididas, se resuelven las ligaduras, se quitan encabezados y números de página, se omiten índices y las tablas (EPUB) se leen fila a fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours actif : les césures sont recollées, les ligatures résolues, en-têtes courants et numéros de page supprimés, index ignorés, tableaux (EPUB) lus ligne par ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre attivo: sillabazioni ricongiunte, legature risolte, testatine e numeri di pagina rimossi, indici saltati, tabelle (EPUB) lette riga per riga."
          }
        }
      }
    },
