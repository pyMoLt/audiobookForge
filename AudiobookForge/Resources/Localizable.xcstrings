    "Braucht ein Modell mit Bildverständnis (z. B. Qwen3.5/3.6 als VLM in oMLX). Mehr parallele Beschreibungen nutzen Continuous Batching.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs a model with image understanding (e.g. Qwen3.5/3.6 as VLM in oMLX). More parallel descriptions use continuous batching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita un modelo con comprensión de imágenes (p. ej. Qwen3.5/3.6 como VLM en oMLX). Más descripciones en paralelo usan continuous batching."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite un modèle capable de comprendre les images (p. ex. Qwen3.5/3.6 comme VLM dans oMLX). Davantage de descriptions parallèles utilisent le continuous batching."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede un modello in grado di comprendere le immagini (ad es. Qwen3.5/3.6 come VLM in oMLX). Più descrizioni in parallelo usano il continuous batching."
          }
        }
      }
    },
