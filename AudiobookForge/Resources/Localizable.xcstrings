    "Entfernt %@. Bücher mit diesen Stimmen lassen sich danach erst wieder vertonen, wenn du sie neu lädst.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes %@. Books with these voices can only be narrated again after you download them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina %@. Los libros con estas voces solo se podrán volver a narrar tras descargarlas de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime %@. Les livres utilisant ces voix ne pourront être relus qu'après un nouveau téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove %@. I libri con queste voci potranno essere narrati di nuovo solo dopo averle riscaricate."
          }
        }
      }
    },
    "Entfernt Klicks, rauscht leicht ab und hebt die Präsenz über 5 kHz um 2 dB an. Hilft vor allem Phonon, das etwas dumpf klingt. Kostet rund 3 Sekunden Rechenzeit pro 10 Minuten Audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes clicks, reduces noise slightly and lifts presence above 5 kHz by 2 dB. Helps Phonon in particular, which sounds a little dull. Costs about 3 seconds of processing per 10 minutes of audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Removes clicks, reduces noise slightly and lifts presence above 5 kHz by 2 dB. Helps Phonon in particular, which sounds a little dull. Costs about 3 seconds of processing per 10 minutes of audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Removes clicks, reduces noise slightly and lifts presence above 5 kHz by 2 dB. Helps Phonon in particular, which sounds a little dull. Costs about 3 seconds of processing per 10 minutes of audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Removes clicks, reduces noise slightly and lifts presence above 5 kHz by 2 dB. Helps Phonon in particular, which sounds a little dull. Costs about 3 seconds of processing per 10 minutes of audio."
          }
        }
      }
    },
