    "Kurze 8-Bit-Töne: fertiges Hörbuch, Eulenpost, Erfolge, Streicheln.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short 8-bit sounds: finished audiobook, owl post, achievements, petting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonidos breves de 8 bits: audiolibro terminado, correo lechuza, logros, caricias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courts sons 8 bits : livre terminé, hibou postal, succès, caresses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brevi suoni a 8 bit: audiolibro pronto, posta via gufo, obiettivi, carezze."
          }
        }
      }
    },
    "Kyutais Pocket TTS: schnell auf der CPU, Deutsch, Englisch, Französisch, Spanisch und Italienisch, dazu lokales Stimmklonen aus einer kurzen Aufnahme. Jede Stimme spricht jede Sprache; die Muttersprachler-Stimme klingt am natürlichsten. CC BY 4.0.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyutai's Pocket TTS: fast on the CPU, German, English, French, Spanish and Italian, plus local voice cloning from a short recording. Every voice speaks every language; the native-speaker voice sounds most natural. CC BY 4.0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket TTS de Kyutai: rápido en la CPU, alemán, inglés, francés, español e italiano, además de clonación de voz local a partir de una grabación corta. Cada voz habla todos los idiomas; la voz nativa suena más natural. CC BY 4.0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket TTS de Kyutai : rapide sur le CPU, allemand, anglais, français, espagnol et italien, plus le clonage vocal local à partir d'un court enregistrement. Chaque voix parle chaque langue ; la voix native sonne le plus naturellement. CC BY 4.0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket TTS di Kyutai: veloce sulla CPU, tedesco, inglese, francese, spagnolo e italiano, più clonazione vocale locale da una breve registrazione. Ogni voce parla ogni lingua; la voce madrelingua suona più naturale. CC BY 4.0."
          }
        }
      }
    },
    "Kyutais Pocket TTS: schnell auf der CPU, fünf Sprachen, jede Stimme spricht jede Sprache. Klont eigene Stimmen lokal aus 10–20 Sekunden Aufnahme. Optional 24-Schichten-Modelle für mehr Natürlichkeit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyutai's Pocket TTS: fast on the CPU, five languages, every voice speaks every language. Clones your own voice locally from a 10–20 second recording. Optional 24-layer models for more natural speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket TTS de Kyutai: rápido en la CPU, cinco idiomas, cada voz habla todos los idiomas. Clona tu propia voz localmente a partir de una grabación de 10 a 20 segundos. Modelos opcionales de 24 capas para un habla más natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket TTS de Kyutai : rapide sur le CPU, cinq langues, chaque voix parle chaque langue. Clone votre voix localement à partir d'un enregistrement de 10 à 20 secondes. Modèles optionnels à 24 couches pour une parole plus naturelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket TTS di Kyutai: veloce sulla CPU, cinque lingue, ogni voce parla ogni lingua. Clona la tua voce localmente da una registrazione di 10–20 secondi. Modelli opzionali a 24 strati per un parlato più naturale."
          }
        }
      }
    },
