    "Farben fließen ineinander, Seiten blättern um. „Reduziert“ hält alles still.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colours flow into each other, pages turn. “Reduced” keeps everything still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores se funden, las páginas pasan. «Reducido» lo deja todo quieto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs se fondent, les pages se tournent. « Réduit » garde tout immobile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colori si fondono, le pagine si girano. «Ridotto» tiene tutto fermo."
          }
        }
      }
    },
