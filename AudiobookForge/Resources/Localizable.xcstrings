    "Überwacht den Arbeitsspeicher während der Audio-Synthese (inklusive aller Hintergrund-Worker), um macOS vor Überlastung zu schützen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitors memory during audio synthesis (including all background workers) to protect macOS from system freeze."
          }
        }
      }
    },
    "„%@“ neu vertonen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-voice “%@”"
          }
        }
      }
    },
    "„%@“ wird entfernt. Bücher, die sie nutzen, fallen auf ihre Standardstimme zurück.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be removed. Books using it fall back to their default voice."
          }
        }
      }
    },
    "„%@“ wird von Hugging Face (rhasspy/piper-voices, MIT-Lizenz) geladen und in der Piper-Umgebung der App abgelegt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is downloaded from Hugging Face (rhasspy/piper-voices, MIT licence) and stored in the app's Piper environment."
          }
        }
      }
    },
    "„(S. 403)“, „(▶ Abb. 6.8)“": {
      "extractionState": "manual",
