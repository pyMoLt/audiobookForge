    "Abweichend vom Standard spricht Phonon auch im Stromsparmodus über die CPU statt die Neural Engine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Away from the default, Phonon uses the CPU instead of the Neural Engine, even in power-saving mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera del valor estándar, Phonon usa la CPU en lugar del Neural Engine, incluso en modo de ahorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors valeur par défaut, Phonon utilise le CPU au lieu du Neural Engine, même en mode économie d'énergie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
