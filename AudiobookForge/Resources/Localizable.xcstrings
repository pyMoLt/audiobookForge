    "10–20 Sekunden gleichmäßiges Sprechen EINER Stimme in ruhiger Umgebung. Längere Aufnahmen werden auf 10 Sekunden gekürzt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10–20 seconds of steady speech by ONE voice in a quiet room. Longer recordings are trimmed to 10 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 10 a 20 segundos de habla continua de UNA sola voz en una sala tranquila. Las grabaciones más largas se recortan a 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 à 20 secondes de parole régulière d'UNE seule voix dans une pièce calme. Les enregistrements plus longs sont coupés à 10 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 10 a 20 secondi di parlato continuo di UNA sola voce in una stanza silenziosa. Le registrazioni più lunghe vengono tagliate a 10 secondi."
          }
        }
      }
    },
