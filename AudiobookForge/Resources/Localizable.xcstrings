    "Kapitel-Audio-Zwischenspeicher, Verarbeitungsprotokolle und temporäre Sicherungen werden geleert. Deine Bücher und Einstellungen bleiben erhalten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter audio cache, processing logs and temporary backups will be emptied. Your books and settings are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vaciarán la caché de audio de capítulos, los registros de procesamiento y las copias temporales. Tus libros y ajustes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache audio des chapitres, les journaux de traitement et les sauvegardes temporaires seront vidés. Vos livres et réglages sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno svuotati la cache audio dei capitoli, i log di elaborazione e i backup temporanei. I tuoi libri e le impostazioni restano."
          }
        }
      }
    },
