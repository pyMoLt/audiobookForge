    "Fehlt etwas? Den Befehl kopieren, im Terminal einfügen (Homebrew: brew.sh) und danach hier erneut prüfen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something missing? Copy the command, paste it into Terminal (Homebrew: brew.sh), then check again here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Falta algo? Copia el comando, pégalo en Terminal (Homebrew: brew.sh) y vuelve a comprobarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque quelque chose ? Copiez la commande, collez-la dans Terminal (Homebrew : brew.sh), puis revérifiez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca qualcosa? Copia il comando, incollalo nel Terminale (Homebrew: brew.sh) e poi ricontrolla qui."
