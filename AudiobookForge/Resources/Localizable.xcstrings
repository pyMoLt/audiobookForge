    "Passt die Kapitelleiste nicht mehr ins Fenster, wird sie zum Hals eines Hundes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the chapter bar no longer fits the window, it becomes a dog's neck."
          }
        },
        "es": {
          "stringUnit": {
