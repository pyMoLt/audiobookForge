        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads with your own voice — runs entirely locally. Pocket TTS is much faster, OmniVoice speaks more languages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee con tu propia voz, todo en local. Pocket TTS es mucho más rápido, OmniVoice habla más idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit avec votre propre voix — entièrement en local. Pocket TTS est bien plus rapide, OmniVoice parle plus de langues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge con la tua voce, interamente in locale. Pocket TTS è molto più veloce, OmniVoice parla più lingue."
          }
        }
      }
    },
