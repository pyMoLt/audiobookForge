    "Die App plant Pausen an Satz-, Absatz- und Überschriftengrenzen und legt die Stille selbst in die Audiodaten — Mitlesen und Kapitelmarken bleiben exakt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app plans pauses at sentence, paragraph and heading boundaries and puts the silence into the audio itself — read-along and chapter marks stay exact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app planifica pausas en los límites de frases, párrafos y títulos e inserta el silencio en el propio audio: la lectura sincronizada y las marcas de capítulo siguen siendo exactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app planifie les pauses aux limites de phrases, de paragraphes et de titres et insère elle-même le silence dans l'audio — la lecture synchronisée et les marques de chapitre restent exactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app pianifica le pause ai confini di frasi, paragrafi e titoli e inserisce il silenzio nell'audio stesso: lettura sincronizzata e segni di capitolo restano esatti."
          }
        }
      }
    },
    "Die Datei wird kopiert — das Original bleibt unverändert an Ort und Stelle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is copied — the original stays where it is, unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se copia: el original queda donde está, sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est copié — l'original reste à sa place, inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file viene copiato: l'originale resta dov'è, invariato."
          }
        }
      }
    },
    "Die Hörprobe bleibt; zum Vorlesen lädst du die Stimme hier wieder.": {
      "extractionState": "manual",
