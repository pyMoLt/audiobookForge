    "%d Kapitel — der Hund hat einen sehr langen Hals. Kopf antippen zum Streicheln.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d chapters — the dog has a very long neck. Tap the head to pet it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%d capítulos: el perro tiene un cuello muy largo. Toca la cabeza para acariciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d chapitres — le chien a un très long cou. Touchez la tête pour le caresser."
