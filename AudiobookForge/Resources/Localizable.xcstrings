    "oMLX verarbeitet parallele Anfragen gemeinsam (Continuous Batching); LM Studio nacheinander. Kontextlimit 0 = vom Server gemeldetes Fenster.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "oMLX processes parallel requests together (continuous batching); LM Studio one after another. Context limit 0 = window reported by the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "oMLX procesa las solicitudes en paralelo juntas (continuous batching); LM Studio una tras otra. Límite de contexto 0 = ventana indicada por el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "oMLX traite les requêtes parallèles ensemble (continuous batching) ; LM Studio les unes après les autres. Limite de contexte 0 = fenêtre indiquée par le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "oMLX elabora insieme le richieste parallele (continuous batching); LM Studio una dopo l'altra. Limite di contesto 0 = finestra indicata dal server."
          }
        }
      }
    },
