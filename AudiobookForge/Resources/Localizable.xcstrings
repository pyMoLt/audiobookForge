    "Natürlicher, aber etwa dreimal langsamer und 2,4 GB Arbeitsspeicher je Worker. Braucht das 24-Schichten-Modell der Sprache.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More natural, but about three times slower and 2.4 GB of memory per worker. Needs the language's 24-layer model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más natural, pero unas tres veces más lento y 2,4 GB de memoria por worker. Necesita el modelo de 24 capas del idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus naturel, mais environ trois fois plus lent et 2,4 Go de mémoire par worker. Nécessite le modèle 24 couches de la langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più naturale, ma circa tre volte più lento e 2,4 GB di memoria per worker. Richiede il modello a 24 strati della lingua."
          }
        }
      }
    },
    "Natürlicher, aber etwa dreimal langsamer und 2,4 GB Arbeitsspeicher je Worker. Braucht das jeweilige Modell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More natural, but about three times slower and 2.4 GB of memory per worker. Needs the matching model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más natural, pero unas tres veces más lento y 2,4 GB de memoria por worker. Necesita el modelo correspondiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus naturel, mais environ trois fois plus lent et 2,4 Go de mémoire par worker. Nécessite le modèle correspondant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più naturale, ma circa tre volte più lento e 2,4 GB di memoria per worker. Richiede il modello corrispondente."
          }
        }
      }
    },
