    "Überwacht den Arbeitsspeicher während der Audio-Synthese (inklusive aller Hintergrund-Worker), um macOS vor Überlastung zu schützen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitors memory during audio synthesis (including all background workers) to protect macOS from system freeze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigila la memoria durante la síntesis de audio (incluidos todos los workers en segundo plano) para proteger macOS de bloqueos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveille la mémoire pendant la synthèse audio (y compris tous les workers en arrière-plan) pour protéger macOS d'un blocage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora la memoria durante la sintesi audio (inclusi tutti i worker in background) per proteggere macOS dai blocchi."
          }
        }
      }
    },
