    "Pausen folgen dem Text: länger nach „…“, Fragen, langen Sätzen und vor wörtlicher Rede, kürzer nach kurzen Sätzen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses follow the text: longer after “…”, questions, long sentences and before dialogue, shorter after short sentences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pausas siguen el texto: más largas tras «…», preguntas, frases largas y antes de diálogos, más cortas tras frases cortas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pauses suivent le texte : plus longues après « … », les questions, les phrases longues et avant un dialogue, plus courtes après les phrases courtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pause seguono il testo: più lunghe dopo «…», domande, frasi lunghe e prima dei dialoghi, più brevi dopo frasi brevi."
          }
        }
      }
    },
    "Pausen schwanken leicht, damit es nicht maschinell klingt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses vary slightly so it doesn't sound mechanical."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pausas varían un poco para que no suene mecánico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pauses varient légèrement pour ne pas sonner mécanique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pause variano leggermente per non sembrare meccaniche."
          }
        }
      }
    },
