            "value": "The vision model describes every figure; the description is read as “Figure: …” exactly where it appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de visión describe cada figura; la descripción se lee como «Figura: …» justo donde aparece."
