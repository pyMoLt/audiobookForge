    "Erkennt die Buchsprache und nimmt die passende Standardstimme.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detects the book's language and picks the matching default voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta el idioma del libro y elige la voz predeterminada correspondiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte la langue du livre et choisit la voix par défaut correspondante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileva la lingua del libro e sceglie la voce predefinita corrispondente."
          }
        }
      }
    },
    "Erkennt die Buchsprache und nimmt die passende Standardstimme; aus = immer die Stimme für andere Sprachen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detects the book's language and uses its default voice; off = always the voice for other languages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta el idioma del libro y usa su voz estándar; desactivado = siempre la voz para otros idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte la langue du livre et utilise sa voix par défaut ; désactivé = toujours la voix des autres langues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosce la lingua del libro e usa la sua voce predefinita; disattivato = sempre la voce per le altre lingue."
          }
        }
      }
    },
