    "Netzteil": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power adapter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptador de corriente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secteur"
          }
        },
        "it": {
